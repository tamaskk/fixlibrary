# Copy to .env.local for development. Names only; never commit values.
# The packaged app ignores .env files: keys are entered on the Settings page
# and stored encrypted via the macOS Keychain.

# AcoustID application key (fingerprint lookup)
ACOUSTID_API_KEY=

# Discogs API consumer key and secret (metadata and cover lookup)
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
